{
  "id": "fever",
  "label": {"en": "Fever", "hi": "बुखार", "hinglish": "Bukhar"},
  "raise_care": "keep",
  "trigger": "fever or temp_f is not None or platelets is not None or named_dengue or named_malaria or named_typhoid or named_chikungunya",
  "stages": {
    "S0": {"care_type": "gp_teleconsult", "urgency": "routine"},
    "S1": {"care_type": "paramedic_home_visit", "urgency": "same_day"},
    "S2": {"care_type": "gp_teleconsult", "urgency": "same_day"},
    "S3": {"care_type": "emergency_referral", "urgency": "immediate"}
  },
  "signs": {
    "fever": {"patterns": ["fever", "bukh?aa?r", "bukar", "bhukar", "temperature", "\\btemp\\b", "taap", "बुखार", "तापमान"],
              "label": {"en": "fever", "hi": "बुखार", "hinglish": "bukhar"}},
    "body_ache": {"patterns": ["body ?(ache|pain)", "badan (\\S+ )?(dard|toot)", "sharir (mein )?dard", "बदन (दर्द|टूट)"],
                  "label": {"en": "body ache", "hi": "बदन दर्द", "hinglish": "badan dard"}},
    "retro_orbital": {"patterns": ["aankh\\w* ke peeche (\\S+ )?dard", "pain behind (the )?eyes", "आँखों के पीछे"],
                      "label": {"en": "pain behind the eyes", "hi": "आँखों के पीछे दर्द", "hinglish": "aankhon ke peeche dard"}},
    "severe_joint_pain": {"patterns": ["(ghutn|kalai|kalaiy|jodon|jod|joints?|haath pair)\\w* (\\S+ ){0,2}(mein )?(itna |bahut |tez )?dard", "joint pain", "chal nahi pa (raha|rahi|rahe)", "can'?t walk (because|due) (of )?(the )?pain", "जोड़ों में दर्द", "घुटन.{0,16}दर्द", "चल नहीं पा"],
                          "label": {"en": "severe joint pain", "hi": "जोड़ों में तेज़ दर्द", "hinglish": "jodon mein tez dard"}},
    "rash": {"patterns": ["rash", "laal daane", "daane", "dane nikle", "chakatte", "red spots", "दाने", "चकत्ते"],
             "label": {"en": "rash", "hi": "दाने", "hinglish": "daane"}},
    "chills": {"patterns": ["thand (lag|lagkar|lag ke)", "kapkapi", "kanpkanpi", "kaanp", "chills", "shiver", "rigou?r", "ठंड लग", "कंपकंपी", "काँप"],
               "label": {"en": "chills and shivering", "hi": "ठंड लगकर कंपकंपी", "hinglish": "thand lagkar kapkapi"}},
    "sweating": {"patterns": ["paseen", "pasina", "sweat", "पसीना"], "label": {"en": "sweating", "hi": "पसीना", "hinglish": "paseena"}},
    "cyclic": {"patterns": ["roz (shaam|raat|subah)", "har (din|roz|shaam)", "aata[- ]jaata", "aata hai phir", "comes and goes", "every (evening|day|night)", "in cycles", "baar[- ]baar aata", "रोज़ शाम", "आता जाता"],
               "label": {"en": "fever that comes and goes", "hi": "बुखार आता-जाता है", "hinglish": "bukhar aata-jaata hai"}},
    "persistent_vomiting": {"patterns": ["baar[- ]baar ult", "lagatar ult", "ult\\w* (ruk|band) (nahi|nhi)", "persistent vomit", "vomiting (a lot|repeatedly|again and again)", "बार बार उल्टी", "लगातार उल्टी"],
                            "label": {"en": "repeated vomiting", "hi": "बार-बार उल्टी", "hinglish": "baar-baar ulti"}},
    "yellow_eyes": {"patterns": ["aa?nkh\\w* (\\S+ )?(peeli|pili|peele|pile)", "yellow (eyes|skin)", "eyes (are |look )?yellow", "peeliya", "piliya", "आँखें पीली", "पीलिया"],
                    "label": {"en": "yellow eyes or skin", "hi": "आँखें या त्वचा पीली", "hinglish": "aankhen ya skin peeli"}},
    "dark_urine": {"patterns": ["peshab (\\S+ )?(peela|peeli|gehra|dark|kaala)", "dark (yellow )?urine", "cola", "पेशाब (पीला|गहरा)"],
                   "label": {"en": "dark yellow urine", "hi": "गहरा पीला पेशाब", "hinglish": "gehra peela peshab"}},
    "burning_urine": {"patterns": ["peshab (mein |me |karte waqt )?jalan", "pishab (mein )?jalan", "urine (mein )?jalan", "burning (while |when )?(passing )?(urine|urinat|peeing)", "पेशाब में जलन"],
                      "label": {"en": "burning while passing urine", "hi": "पेशाब में जलन", "hinglish": "peshab mein jalan"}},
    "flank_pain": {"patterns": ["kamar (ke |ki )?(side|bagal|ek taraf)", "side (mein|me) (\\S+ )?dard", "flank", "pain in (my |the )?(side|back) (near|above)", "side of (the |my |his |her )?(back|waist)", "कमर के (साइड|बगल)"],
                   "label": {"en": "pain in the side of the back", "hi": "कमर के एक तरफ दर्द", "hinglish": "kamar ke side mein dard"}},
    "constipation": {"patterns": ["kabz", "constipat", "potty (nahi|nhi) (ho|aa)", "कब्ज"], "label": {"en": "constipation", "hi": "कब्ज़", "hinglish": "kabz"}},
    "step_rising": {"patterns": ["roz badh", "badhta (ja )?raha", "rising (every day|daily)", "getting higher", "बढ़ता जा रहा"],
                    "label": {"en": "fever rising day by day", "hi": "बुखार रोज़ बढ़ रहा है", "hinglish": "bukhar roz badh raha hai"}},
    "fever_down": {"patterns": ["bukh?aa?r (\\S+ )?(utar|kam ho|chala|chal) (gaya|gya|gaya hai)", "fever (went|has gone|came|is) down", "fever (has )?(settled|gone)", "बुखार उतर गया"],
                   "label": {"en": "fever went down", "hi": "बुखार उतर गया", "hinglish": "bukhar utar gaya"}},
    "severe_headache": {"patterns": ["(bahut|bohot|bht|boht|itna|bahot) (zyada |jyada )?tez (sir|sar) ?(mein |me )?dard", "(sir|sar) (mein |me )?(bahut|bohot|bht|itna) (tez|zyada|jyada) dard", "(severe|very bad|terrible|bad) headache", "बहुत तेज़ सिर ?दर्द", "सिर में बहुत तेज़ दर्द"],
                        "label": {"en": "very bad headache", "hi": "बहुत तेज़ सिर दर्द", "hinglish": "bahut tez sir dard"}},
    "breathless_exertion": {"patterns": ["(chalne|seedhi chadhne|kaam karne) (par|pe|se) saa?ns (phool|ful|phul)", "breathless (on|when|while) (walking|climbing|exertion)", "चलने पर साँस"],
                            "label": {"en": "breathless on walking", "hi": "चलने पर साँस फूलना", "hinglish": "chalne par saans phoolna"}},
    "weakness_severe": {"patterns": ["bahut (zyada )?kamz?j?ori", "very weak", "extremely weak", "(bistar|bed) se uth nahi", "can'?t get out of bed", "बिस्तर से उठ नहीं", "bechain", "restless", "बहुत कमज़ोरी", "बहुत कमजोरी", "बेचैन"],
                        "label": {"en": "severe weakness or restlessness", "hi": "बहुत कमज़ोरी या बेचैनी", "hinglish": "bahut kamzori ya bechaini"}}
  },
  "rules": [
    {"id": "f_hyperpyrexia", "stage": "S3", "when": "temp_f is not None and temp_f >= 105.8"},
    {"id": "f_confusion", "stage": "S3", "when": "fever and (confusion or very_drowsy or unconscious)", "pattern": "jaundice_like"},
    {"id": "f_seizure", "stage": "S3", "when": "fever and seizure"},
    {"id": "f_meningitis", "stage": "S3", "when": "fever and (stiff_neck or non_fading_rash)", "pattern": "meningitis_like"},
    {"id": "f_platelets_below_20k", "stage": "S3", "when": "platelets is not None and platelets < 20000", "pattern": "dengue_like"},
    {"id": "f_platelets_with_bleeding", "stage": "S3", "when": "platelets is not None and bleeding_any", "pattern": "dengue_like"},
    {"id": "f_platelets_20_50k_warning", "stage": "S3", "when": "platelets is not None and platelets < 50000 and (abdominal_pain or persistent_vomiting or weakness_severe or vomit_count >= 3)", "pattern": "dengue_like"},
    {"id": "f_shock_signs", "stage": "S3", "when": "fever and (cold_clammy or reduced_urine or breathless_rest or black_stool)", "pattern": "dengue_like"},
    {"id": "f_heavy_bleeding", "stage": "S3", "when": "fever and bleeding_any and blood_large", "pattern": "dengue_like"},
    {"id": "f_malaria_danger", "stage": "S3", "when": "fever and chills and (yellow_eyes or dark_urine or breathless_rest)", "pattern": "malaria_like"},
    {"id": "f_typhoid_danger", "stage": "S3", "when": "fever and abdominal_pain and (rigid_belly or blood_in_stool)", "pattern": "typhoid_like"},
    {"id": "f_pneumonia_danger", "stage": "S3", "when": "fever and cough and (breathless_rest or blue_lips)", "pattern": "pneumonia_like"},
    {"id": "f_uti_danger", "stage": "S3", "when": "burning_urine and reduced_urine", "pattern": "uti_like"},

    {"id": "f_temp_104", "stage": "S2", "when": "temp_f is not None and temp_f >= 104"},
    {"id": "f_over_14_days", "stage": "S2", "when": "fever and duration_days is not None and duration_days > 14", "care_type": "specialist_referral"},
    {"id": "f_over_7_days", "stage": "S2", "when": "fever and duration_days is not None and duration_days > 7", "pattern": "typhoid_like"},
    {"id": "f_platelets_below_1_lakh", "stage": "S2", "when": "platelets is not None and platelets < 100000", "pattern": "dengue_like", "note": "home_blood_test"},
    {"id": "f_dengue_warning", "stage": "S2", "when": "(fever or platelets is not None or named_dengue) and (abdominal_pain or persistent_vomiting or vomit_count >= 3 or bleeding_any or weakness_severe) and ((duration_days is not None and duration_days >= 2) or named_dengue or platelets is not None)", "pattern": "dengue_like"},
    {"id": "f_down_but_worse", "stage": "S2", "when": "fever_down and (weakness_severe or abdominal_pain or persistent_vomiting or very_drowsy or bleeding_any)", "pattern": "dengue_like"},
    {"id": "f_malaria_warning", "stage": "S2", "when": "fever and chills and (weakness_severe or persistent_vomiting)", "pattern": "malaria_like"},
    {"id": "f_jaundice_warning", "stage": "S2", "when": "yellow_eyes and (persistent_vomiting or vomit_count >= 3)", "pattern": "jaundice_like"},
    {"id": "f_uti_warning", "stage": "S2", "when": "burning_urine and (flank_pain or persistent_vomiting or (temp_f is not None and temp_f >= 103))", "pattern": "uti_like"},
    {"id": "f_pneumonia_warning", "stage": "S2", "when": "fever and cough and (fast_breathing or chest_pain_breathing or breathless)", "pattern": "pneumonia_like"},
    {"id": "f_vomiting_persistent", "stage": "S2", "when": "fever and (persistent_vomiting or vomit_count >= 4)"},
    {"id": "f_severe_abdominal_pain", "stage": "S2", "when": "fever and severe_pain", "pattern": "typhoid_like"},
    {"id": "f_breathless", "stage": "S2", "when": "fever and (breathless or breathless_exertion)", "pattern": "pneumonia_like"},
    {"id": "f_severe_headache", "stage": "S2", "when": "fever and severe_headache", "pattern": "meningitis_like"},
    {"id": "f_bleeding", "stage": "S2", "when": "fever and bleeding_any", "pattern": "dengue_like", "note": "home_blood_test"},

    {"id": "f_two_days", "stage": "S1", "when": "fever and duration_days is not None and duration_days >= 2"},
    {"id": "f_temp_103", "stage": "S1", "when": "temp_f is not None and temp_f >= 103"},
    {"id": "f_malaria_like", "stage": "S1", "when": "fever and chills and (cyclic or sweating)", "pattern": "malaria_like"},
    {"id": "f_dengue_like", "stage": "S1", "when": "fever and (retro_orbital or (body_ache and temp_f is not None and temp_f >= 102))", "pattern": "dengue_like"},
    {"id": "f_chikungunya_like", "stage": "S1", "when": "fever and severe_joint_pain", "pattern": "chikungunya_like"},
    {"id": "f_jaundice_like", "stage": "S1", "when": "yellow_eyes or (fever and dark_urine)", "pattern": "jaundice_like"},
    {"id": "f_uti_like", "stage": "S1", "when": "fever and burning_urine", "care_type": "gp_teleconsult", "pattern": "uti_like"},
    {"id": "f_rash", "stage": "S1", "when": "fever and rash"},
    {"id": "f_named_infection", "stage": "S1", "when": "named_dengue or named_malaria or named_typhoid or named_chikungunya"},

    {"id": "f_mild", "stage": "S0", "when": "fever and ((temp_f is not None and temp_f < 101) or mild_fever) and (duration_days is None or duration_days < 2) and not high_fever_reported"}
  ],
  "sufficient": "(known(duration_days) and (known(temp_f) or high_fever_reported or mild_fever or n_signs >= 1)) or platelets is not None",
  "questions": [
    {"id": "fever.danger", "kind": "danger",
     "text": {"en": "With the fever, is any of these happening?", "hi": "बुखार के साथ क्या इनमें से कुछ हो रहा है?", "hinglish": "Bukhar ke saath inme se kuch ho raha hai?"},
     "skip_if": "known(very_drowsy) and known(breathless) and known(bleeding_any) and known(stiff_neck) and known(seizure)",
     "_chips": "one sign per chip. definite_S3 -> emergency at once; needs_confirmation -> one targeted confirmation question",
     "chips": [
       {"id": "drowsy", "severity": "definite_S3", "label": {"en": "Very drowsy, hard to wake", "hi": "बहुत सुस्त, जगाना मुश्किल", "hinglish": "Bahut sust, jagana mushkil"}, "facts": {"very_drowsy": true}},
       {"id": "confused", "severity": "definite_S3", "label": {"en": "Talking confused", "hi": "उल्टा-सीधा बोल रहे हैं", "hinglish": "Ulta-seedha bol rahe"}, "facts": {"confusion": true}},
       {"id": "breath_rest", "severity": "definite_S3", "label": {"en": "Breathless even at rest", "hi": "आराम में भी साँस फूल रही है", "hinglish": "Aaram mein bhi saans phool rahi"}, "facts": {"breathless_rest": true}},
       {"id": "breath_walk", "severity": "needs_confirmation", "label": {"en": "Breathless on walking", "hi": "चलने पर साँस फूलती है", "hinglish": "Chalne par saans phoolti hai"}, "facts": {"breathless": true}},
       {"id": "neck", "severity": "definite_S3", "label": {"en": "Stiff neck", "hi": "गर्दन अकड़ गई है", "hinglish": "Gardan akad gayi"}, "facts": {"stiff_neck": true}},
       {"id": "headache", "severity": "needs_confirmation", "label": {"en": "Very bad headache", "hi": "बहुत तेज़ सिर दर्द", "hinglish": "Bahut tez sir dard"}, "facts": {"severe_headache": true}},
       {"id": "bleed", "severity": "needs_confirmation", "label": {"en": "Bleeding from anywhere", "hi": "कहीं से खून आना", "hinglish": "Kahin se khoon aana"}, "facts": {"bleeding_any": true}},
       {"id": "fit", "severity": "definite_S3", "label": {"en": "Had a fit (seizure)", "hi": "दौरा पड़ा", "hinglish": "Daura pada"}, "facts": {"seizure": true}}
     ]},
    {"id": "fever.confirm_breath", "kind": "confirm", "only_if": "breathless and not breathless_rest and not blue_lips",
     "text": {"en": "About the breathing, which of these is true?", "hi": "साँस के बारे में, इनमें से क्या सही है?", "hinglish": "Saans ke baare mein, inme se kya sahi hai?"},
     "chips": [
       {"id": "sitting", "severity": "definite_S3", "label": {"en": "Breathless even sitting still", "hi": "बैठे-बैठे भी साँस फूलती है", "hinglish": "Baithe-baithe bhi saans phoolti hai"}, "facts": {"breathless_rest": true}},
       {"id": "speak", "severity": "definite_S3", "label": {"en": "Cannot finish a sentence", "hi": "पूरी बात एक साँस में नहीं बोल पाते", "hinglish": "Poori baat ek saans mein nahi bol paate"}, "facts": {"breathless_rest": true}},
       {"id": "blue", "severity": "definite_S3", "label": {"en": "Blue lips or nails", "hi": "होंठ या नाखून नीले", "hinglish": "Hont ya naakhun neele"}, "facts": {"blue_lips": true}},
       {"id": "walk", "label": {"en": "Only on walking or climbing stairs", "hi": "सिर्फ़ चलने या सीढ़ी चढ़ने पर", "hinglish": "Sirf chalne ya seedhi chadhne par"}, "facts": {"breathless_exertion": true}}
     ], "no_none_chip": true},
    {"id": "fever.confirm_headache", "kind": "confirm", "only_if": "severe_headache and not stiff_neck and not confusion",
     "text": {"en": "With the bad headache, is any of these there?", "hi": "तेज़ सिर दर्द के साथ क्या इनमें से कुछ है?", "hinglish": "Tez sir dard ke saath inme se kuch hai?"},
     "chips": [
       {"id": "neck", "severity": "definite_S3", "label": {"en": "Neck will not bend forward", "hi": "गर्दन आगे नहीं झुकती", "hinglish": "Gardan aage nahi jhukti"}, "facts": {"stiff_neck": true}},
       {"id": "confused", "severity": "definite_S3", "label": {"en": "Confused or talking strangely", "hi": "भ्रम या अजीब बातें", "hinglish": "Bhram ya ajeeb baatein"}, "facts": {"confusion": true}},
       {"id": "drowsy", "severity": "definite_S3", "label": {"en": "Hard to wake", "hi": "जगाना मुश्किल", "hinglish": "Jagana mushkil"}, "facts": {"very_drowsy": true}},
       {"id": "rash", "severity": "definite_S3", "label": {"en": "Purple spots that do not fade on pressing", "hi": "बैंगनी दाने जो दबाने पर नहीं जाते", "hinglish": "Baingani daane jo dabane par nahi jaate"}, "facts": {"non_fading_rash": true}},
       {"id": "vomit", "label": {"en": "Vomiting again and again", "hi": "बार-बार उल्टी हो रही", "hinglish": "Baar-baar ulti ho rahi"}, "facts": {"persistent_vomiting": true}},
       {"id": "light", "label": {"en": "Light hurts the eyes", "hi": "रोशनी से आँखों में तकलीफ", "hinglish": "Roshni se aankhon mein takleef"}, "facts": {"light_sensitivity": true}}
     ]},
    {"id": "fever.confirm_bleed", "kind": "confirm", "only_if": "bleeding_any and not blood_large and not blood_vomit and not black_stool",
     "text": {"en": "About the bleeding, which is true?", "hi": "खून के बारे में क्या सही है?", "hinglish": "Khoon ke baare mein kya sahi hai?"},
     "chips": [
       {"id": "little", "label": {"en": "A little from gums or nose", "hi": "मसूड़ों या नाक से थोड़ा सा", "hinglish": "Masoodon ya naak se thoda sa"}, "facts": {"blood_small": true}},
       {"id": "vomit", "severity": "definite_S3", "label": {"en": "Vomiting blood", "hi": "खून की उल्टी", "hinglish": "Khoon ki ulti"}, "facts": {"blood_vomit": true}},
       {"id": "black", "severity": "definite_S3", "label": {"en": "Black or bloody stool", "hi": "काली या खून वाली पॉटी", "hinglish": "Potty kaali ya khoon wali"}, "facts": {"black_stool": true}},
       {"id": "lots", "severity": "definite_S3", "label": {"en": "A lot of blood, not stopping", "hi": "बहुत खून, रुक नहीं रहा", "hinglish": "Bahut khoon, ruk nahi raha"}, "facts": {"blood_large": true}}
     ], "no_none_chip": true},
    {"id": "fever.duration_height", "kind": "duration",
     "text": {"en": "Since when is the fever, and how high?", "hi": "बुखार कब से है और कितना?", "hinglish": "Bukhar kab se hai aur kitna?"},
     "skip_if": "known(duration_days) and (known(temp_f) or high_fever_reported or mild_fever)",
     "chips": [
       {"id": "d1", "label": {"en": "1 day", "hi": "1 दिन", "hinglish": "1 din"}, "facts": {"duration_days": 1}},
       {"id": "d3", "label": {"en": "2–3 days", "hi": "2–3 दिन", "hinglish": "2–3 din"}, "facts": {"duration_days": 3}},
       {"id": "d7", "label": {"en": "4–7 days", "hi": "4–7 दिन", "hinglish": "4–7 din"}, "facts": {"duration_days": 6}},
       {"id": "d8", "label": {"en": "More than a week", "hi": "1 हफ्ते से ज़्यादा", "hinglish": "1 hafte se zyada"}, "facts": {"duration_days": 10}},
       {"id": "t1", "label": {"en": "Below 101", "hi": "101 से कम", "hinglish": "101 se kam"}, "facts": {"temp_f": 100}},
       {"id": "t2", "label": {"en": "101–103", "hi": "101–103", "hinglish": "101–103"}, "facts": {"temp_f": 102}},
       {"id": "t3", "label": {"en": "Above 103", "hi": "103 से ज़्यादा", "hinglish": "103 se zyada"}, "facts": {"temp_f": 103.5}},
       {"id": "tn", "label": {"en": "Not measured", "hi": "नापा नहीं", "hinglish": "Naapa nahi"}, "facts": {}}
     ], "no_none_chip": true},
    {"id": "fever.associated", "kind": "associated",
     "text": {"en": "What else is there with the fever?", "hi": "बुखार के साथ और क्या-क्या है?", "hinglish": "Bukhar ke saath kya-kya hai?"},
     "skip_if": "n_signs >= 3",
     "chips": [
       {"id": "chills", "label": {"en": "Chills and shivering", "hi": "ठंड लगकर कंपकंपी", "hinglish": "Thand lagkar kapkapi"}, "facts": {"chills": true}},
