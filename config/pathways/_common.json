    {"id": "comorbid_raise", "when": "comorbid", "effect": "raise", "pathways": "*",
     "label": {"en": "a long-term condition (sugar, heart, kidney, liver, cancer, steroids or HIV)", "hi": "पुरानी बीमारी (शुगर, दिल, किडनी, लीवर, कैंसर, स्टेरॉयड या HIV)", "hinglish": "purani bimari (sugar, dil, kidney, liver, cancer, steroid ya HIV)"}},
    {"id": "bedridden_home", "when": "bedridden", "effect": "prefer_home", "pathways": "*",
