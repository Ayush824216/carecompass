  "pregnancy_question": {"id": "common.pregnancy_weeks", "kind": "pregnancy_weeks", "single": true, "no_none_chip": true, "_note": "asked once in every pathway when a pregnancy is mentioned without weeks; does not count toward the 4", "text": {"en": "How far along is the pregnancy?", "hi": "प्रेग्नेंसी कितने महीने की है?", "hinglish": "Pregnancy kitne mahine ki hai?"}, "chips": [{"id": "t1", "label": {"en": "Under 3 months", "hi": "3 महीने से कम", "hinglish": "3 mahine se kam"}, "facts": {"pregnancy_weeks": 8}}, {"id": "t2", "label": {"en": "3 to 6 months", "hi": "3 से 6 महीने", "hinglish": "3 se 6 mahine"}, "facts": {"pregnancy_weeks": 22}}, {"id": "t3", "label": {"en": "6 to 9 months", "hi": "6 से 9 महीने", "hinglish": "6 se 9 mahine"}, "facts": {"pregnancy_weeks": 32}}, {"id": "unk", "label": {"en": "Not sure", "hi": "पक्का नहीं पता", "hinglish": "Pakka nahi pata"}, "facts": {"pregnancy_weeks_unknown": true}}]},
  "bleeding_question": {"id": "common.bleeding", "kind": "bleeding", "no_none_chip": true, "_note": "any bleeding: where from and how much, asked once (does not count toward the 4); a lot / not stopping -> emergency", "text": {"en": "Where is the blood coming from, and how much?", "hi": "खून कहाँ से आ रहा है, और कितना?", "hinglish": "Khoon kahan se aa raha hai, aur kitna?"}, "chips": [{"id": "heavy", "severity": "definite_S3", "label": {"en": "A lot, it is not stopping", "hi": "बहुत ज़्यादा, रुक नहीं रहा", "hinglish": "Bahut zyada, ruk nahi raha"}, "facts": {"bleed_heavy": true}}, {"id": "little", "label": {"en": "A little, a few drops", "hi": "थोड़ा सा, कुछ बूँदें", "hinglish": "Thoda sa, kuch boondein"}, "facts": {"bleed_small": true}}, {"id": "nose", "label": {"en": "From the nose", "hi": "नाक से", "hinglish": "Naak se"}, "facts": {"bleed_nose": true}}, {"id": "mouth", "label": {"en": "In cough or vomit", "hi": "खाँसी या उल्टी में", "hinglish": "Khaansi ya ulti mein"}, "facts": {"bleed_mouth": true}}, {"id": "stool", "label": {"en": "In stool or urine", "hi": "पॉटी या पेशाब में", "hinglish": "Potty ya peshab mein"}, "facts": {"bleed_stool_urine": true}}, {"id": "vagina", "label": {"en": "From the vagina / periods", "hi": "योनि से / पीरियड", "hinglish": "Neeche se / periods"}, "facts": {"vaginal_bleeding": true}}, {"id": "wound", "label": {"en": "From an injury or wound", "hi": "चोट या घाव से", "hinglish": "Chot ya ghaav se"}, "facts": {"bleed_wound": true}}]},
  "age_question": {"id": "common.age", "kind": "age", "single": true, "no_none_chip": true, "_note": "asked early when the age is unknown; one chip question that does not count toward the 4", "text": {"en": "How old is the patient?", "hi": "मरीज़ की उम्र कितनी है?", "hinglish": "Mareez ki umar kitni hai?"}, "text_self": {"en": "How old are you?", "hi": "आपकी उम्र कितनी है?", "hinglish": "Aapki umar kitni hai?"}, "chips": [{"id": "lt1", "label": {"en": "Under 1 year", "hi": "1 साल से छोटा", "hinglish": "1 saal se chhota"}, "facts": {"age_known": true, "infant": true, "child": true, "under5": true, "minor": true, "age_band": "lt1"}}, {"id": "1_5", "label": {"en": "1–5 years", "hi": "1–5 साल", "hinglish": "1–5 saal"}, "facts": {"age_known": true, "child": true, "under5": true, "minor": true, "age_band": "1-5"}}, {"id": "6_17", "label": {"en": "6–17 years", "hi": "6–17 साल", "hinglish": "6–17 saal"}, "facts": {"age_known": true, "child": true, "minor": true, "age_band": "6-17"}}, {"id": "18_64", "label": {"en": "18–64 years", "hi": "18–64 साल", "hinglish": "18–64 saal"}, "facts": {"age_known": true, "adult": true, "age_band": "18-64"}}, {"id": "65p", "label": {"en": "65+ years", "hi": "65+ साल", "hinglish": "65+ saal"}, "facts": {"age_known": true, "elderly": true, "age_band": "65+"}}]},
