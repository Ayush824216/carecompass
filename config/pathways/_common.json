  "modifiers": [
    {"id": "young_infant_fever", "when": "young_infant and fever and (temp_f is None or temp_f >= 100.4)", "effect": "min_stage", "stage": "S3", "pathways": ["fever"],
     "label": {"en": "a baby under 3 months with fever", "hi": "3 महीने से छोटे शिशु को बुखार", "hinglish": "3 mahine se chhote baby ko bukhar"}},
    {"id": "child_danger", "when": "child and under5 and (cannot_drink or vomits_everything or seizure or very_drowsy or unconscious)", "effect": "min_stage", "stage": "S3", "pathways": "*",
     "label": {"en": "a young child with a danger sign", "hi": "छोटे बच्चे में खतरे का संकेत", "hinglish": "chhote bachche mein khatre ka sanket"}},
    {"id": "elderly_confusion", "when": "elderly and confusion", "effect": "min_stage", "stage": "S3", "pathways": "*",
     "label": {"en": "new confusion in an elderly person", "hi": "बुज़ुर्ग में नया भ्रम", "hinglish": "buzurg mein naya bhram"}},
    {"id": "pregnancy_danger", "when": "pregnant and (abdominal_pain or bleeding_any or (headache and (vision_change or swelling_face_hands)))", "effect": "min_stage", "stage": "S3", "pathways": "*",
     "label": {"en": "pregnancy with pain, bleeding or headache with vision changes", "hi": "गर्भावस्था में दर्द, खून या सिरदर्द के साथ धुंधला दिखना", "hinglish": "pregnancy mein dard, khoon ya sir dard ke saath dhundhla dikhna"}},
    {"id": "pregnancy_fever", "when": "pregnant and fever", "effect": "min_stage", "stage": "S1", "pathways": ["fever"],
     "label": {"en": "fever in pregnancy", "hi": "गर्भावस्था में बुखार", "hinglish": "pregnancy mein bukhar"}},
    {"id": "elderly_raise", "when": "elderly", "effect": "raise", "pathways": ["fever", "cough", "stomach"],
