       {"id": "maybe", "label": {"en": "Period is late, might be", "hi": "पीरियड लेट है, हो सकता है", "hinglish": "Period late hai, ho sakta hai"}, "facts": {"possible_pregnancy": true, "missed_period": true}},
       {"id": "postpartum", "label": {"en": "Baby in the last year", "hi": "पिछले एक साल में डिलीवरी", "hinglish": "Pichhle ek saal mein delivery"}, "facts": {"postpartum": true}}
     ]},
    {"id": "women.main", "kind": "associated",
     "text": {"en": "What is troubling you?", "hi": "क्या परेशानी है?", "hinglish": "Kya pareshani hai?"},
     "skip_if": "period_pain or heavy_period or irregular_period or missed_period or white_discharge or pms_mood or menopause or vaginal_bleeding or pregnant or postpartum",
     "chips": [
       {"id": "pain", "label": {"en": "Painful periods", "hi": "पीरियड में दर्द", "hinglish": "Periods mein dard"}, "facts": {"period_pain": true}},
       {"id": "heavy", "label": {"en": "Heavy periods", "hi": "पीरियड बहुत ज़्यादा", "hinglish": "Periods bahut zyada"}, "facts": {"heavy_period": true}},
       {"id": "irregular", "label": {"en": "Irregular or missed periods", "hi": "पीरियड अनियमित या नहीं आए", "hinglish": "Periods irregular ya nahi aaye"}, "facts": {"irregular_period": true}},
       {"id": "discharge", "label": {"en": "White discharge", "hi": "सफ़ेद पानी", "hinglish": "Safed paani"}, "facts": {"white_discharge": true}},
       {"id": "pms", "label": {"en": "Mood changes before periods", "hi": "पीरियड से पहले मूड बदलना", "hinglish": "Periods se pehle mood badalna"}, "facts": {"pms_mood": true}},
       {"id": "meno", "label": {"en": "Menopause changes", "hi": "मेनोपॉज़ के बदलाव", "hinglish": "Menopause ke badlav"}, "facts": {"menopause": true}}
     ]},
    {"id": "women.duration", "kind": "duration", "single": true, "no_none_chip": true,
     "text": {"en": "Since when has this been going on?", "hi": "यह परेशानी कब से है?", "hinglish": "Yeh pareshani kab se hai?"},
     "skip_if": "known(duration_days)",
     "chips": [
       {"id": "today", "label": {"en": "Since today", "hi": "आज से", "hinglish": "Aaj se"}, "facts": {"duration_days": 0}},
       {"id": "days", "label": {"en": "A few days", "hi": "कुछ दिनों से", "hinglish": "Kuch dino se"}, "facts": {"duration_days": 3}},
       {"id": "cycles", "label": {"en": "For a few cycles / months", "hi": "कुछ महीनों से", "hinglish": "Kuch mahino se"}, "facts": {"duration_days": 90}}
     ]}
  ]
