{
  "_note": "Indicative contract for POST /api/v1/triage (self-written dev version, not the official schema).",
  "endpoint": "POST /api/v1/triage",
  "request": {
    "$defs": {
      "Location": {
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "title": "Location",
        "type": "object"
      },
      "Turn": {
        "properties": {
          "role": {
            "default": "user",
            "enum": [
              "user",
              "assistant",
              "system"
            ],
            "title": "Role",
            "type": "string"
          },
          "content": {
            "default": "",
            "title": "Content",
            "type": "string"
          }
        },
        "title": "Turn",
        "type": "object"
      }
    },
    "examples": [
      {
        "conversation_history": [],
        "language": "auto",
        "location": {
          "lat": 28.54,
          "lng": 77.27
        },
        "user_input": "papa ko do din se bukhar hai aur khansi bhi"
      }
    ],
    "properties": {
      "user_input": {
        "maxLength": 4000,
        "title": "User Input",
        "type": "string"
      },
      "language": {
        "default": "auto",
        "enum": [
          "auto",
          "en",
          "hi",
          "hinglish"
        ],
        "title": "Language",
        "type": "string"
      },
      "location": {
        "anyOf": [
          {
            "$ref": "#/$defs/Location"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "conversation_history": {
        "items": {
          "$ref": "#/$defs/Turn"
        },
        "title": "Conversation History",
        "type": "array"
      }
    },
    "required": [
      "user_input"
    ],
    "title": "TriageRequest",
    "type": "object"
  },
  "response": {
    "$defs": {
      "MatchedCaregiver": {
        "properties": {
          "caregiver_id": {
            "title": "Caregiver Id",
            "type": "string"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "caregiver_id",
          "score",
          "reason"
        ],
        "title": "MatchedCaregiver",
        "type": "object"
      }
    },
    "properties": {
      "follow_up_question": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Follow Up Question"
      },
      "care_type": {
        "anyOf": [
          {
            "enum": [
              "paramedic_home_visit",
              "nurse_home_visit",
              "gp_teleconsult",
              "specialist_referral",
              "emergency_referral"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Care Type"
      },
      "urgency": {
        "anyOf": [
          {
            "enum": [
              "routine",
              "same_day",
              "immediate"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Urgency"
      },
      "red_flags": {
        "items": {
          "type": "string"
        },
        "title": "Red Flags",
        "type": "array"
      },
      "reasoning": {
        "default": "",
        "title": "Reasoning",
        "type": "string"
      },
      "matched_caregivers": {
        "items": {
          "$ref": "#/$defs/MatchedCaregiver"
        },
        "title": "Matched Caregivers",
        "type": "array"
      }
    },
    "title": "TriageResponse",
    "type": "object",
    "required": [
      "follow_up_question",
      "care_type",
      "urgency",
      "red_flags",
      "reasoning",
      "matched_caregivers"
    ]
  }
}