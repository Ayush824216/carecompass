# Copy to .env and fill in. NEVER commit .env.
# --- LLM (hosted; optional: system falls back to local models if unset) ---
LLM_PROVIDER=          # e.g. groq | openai | gemini | anthropic | none
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=6
LLM_SEED=7             # fixed seed where the provider supports one (temperature is always 0)

# --- Data / model paths (relative to repo root) ---
DATA_DIR=data
OFFICIAL_DIR=data/official
PUBLIC_DIR=data/public
PROCESSED_DIR=data/processed
DEV_DATA_DIR=dev_data
MODELS_DIR=models
CONFIG_DIR=config

# --- Runtime ---
USE_TRANSFORMER=auto   # auto | true | false
LOG_LEVEL=INFO
CORS_ORIGINS=*
LOCAL_ONLY=false         # true: no external API calls at all (LLM off)
DEBUG_LOG_TEXT=false     # local development only; never in production
RESPONSE_CACHE_TTL_S=900   # same request -> same cached answer for this long (0 = off; memory only)

# --- Frontend ---
VITE_API_URL=http://localhost:8000
